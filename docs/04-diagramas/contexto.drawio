<mxfile host="app.diagrams.net"><diagram name="C4 - Contexto" id="contexto"><mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" page="1" pageWidth="1100" pageHeight="800"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Diagrama de Contexto (C4 – Nível 1) — ArqFlow&lt;/b&gt;" style="text;html=1;fontSize=18;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="900" height="30" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b&gt;Solicitante de Demanda&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[Pessoa]&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Área de negócio que abre a demanda&lt;/span&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=58;fillColor=#08427B;strokeColor=#052E56;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="95" y="82" width="210" height="124" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b&gt;Arquiteto de Soluções&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[Pessoa]&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Cria cenários, cota custo, anexa diagrama e aprova&lt;/span&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=58;fillColor=#08427B;strokeColor=#052E56;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="395" y="82" width="210" height="124" as="geometry"/></mxCell><mxCell id="p3" value="&lt;b&gt;Gestor / PMO&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px'&gt;[Pessoa]&lt;/span&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Acompanha o andamento das demandas&lt;/span&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingTop=58;fillColor=#08427B;strokeColor=#052E56;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="695" y="82" width="210" height="124" as="geometry"/></mxCell><mxCell id="arq" value="&lt;b&gt;ArqFlow&lt;/b&gt;&lt;br&gt;&lt;span style='fo